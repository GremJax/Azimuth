print "loading standard library..."

#Lang("Object")
shape Object {} 

namespace Math {

    static Neg(x number) -> number 
        return -x
    static BWNot(x number) -> number 
        return ~x

    static Succ(x number) -> number 
        return x + 1

    static Add(a number, b number) -> number 
        return a + b
    static Sub(a number, b number) -> number 
        return a - b
    static Mul(a number, b number) -> number 
        return a * b
    static Div(a number, b number) -> number 
        return a / b
    static Mod(a number, b number) -> number 
        return a % b

    static BWAnd(a number, b number) -> number 
        return a & b
    static BWOr(a number, b number) -> number 
        return a | b
    static BWXor(a number, b number) -> number 
        return a ^ b
    static BWLShift(a number, b number) -> number 
        return a << b
    static BWRShift(a number, b number) -> number 
        return a >> b

    static Abs(x number) -> number 
        return (x >= 0) ? x : -x
    static Max(a number, b number) -> number 
        return (a >= b) ? a : b
    static Min(a number, b number) -> number 
        return (a <= b) ? a : b
    static Clamp(x number, min number, max number) -> number 
        return Max(min, Min(max, x))
    static Sgn(x number) -> number 
        return (x > 0) ? 1 : (x < 0) ? -1 : 0

    static IsEven(x number) -> bool
        return (x % 2) == 0
    static IsOdd(x number) -> bool
        return (x % 2) != 0
    static LT(a number, b number) -> bool
        return a < b
    static LTE(a number, b number) -> bool
        return a <= b
    static GT(a number, b number) -> bool
        return a > b
    static GTE(a number, b number) -> bool
        return a >= b
    static Eq(a number, b number) -> bool
        return a == b
    static NEq(a number, b number) -> bool
        return a != b

    static GCD(a number, b number) -> number {
        while b != 0 {
            let temp = b
            b = a % b
            a = temp
        }
        return a
    }
    static LCM(a number, b number) -> number {
        if a == 0 || b == 0 return 0
        return (a / GCD(a, b)) * b
    }
    static Mid(a number, b number) -> number {
        let max = Max(a,b)
        let min = Min(a,b)
        return min + ((max - min) / 2)
    }

    static Reflect(x number, mid number) -> number 
        return (2 * mid) - x

    static Pow(x number, exp number) -> number {
        let res = 1
        for i in 1 ... exp {
            res *= x
        }
        return res
    }

    static intrinsic Sqrt(x number) -> number

    static Ceil(x double) -> double
        return x - x%1 + 1
    static Floor(x double) -> double
        return x - x%1
}

namespace IO {
    static Print(x string) print x

    static intrinsic ReadLine() -> string?
    static intrinsic Args() -> [string]
}

namespace Random {
    static intrinsic Int() -> int32
    static intrinsic Range(from int, to int) -> int32

    static Chance(chance int) -> bool 
        return Random.Range(1, chance) == 1

    static Bool() -> bool 
        return Random.Chance(2)
}

shape Error {
    Message string = default
    Throw() throw self.Message

    static Try(func |() -> Object|) -> bool
        return func() !~ Error
}

shape Executor {
    Run(hooks [|() -> void|]) {
        for hook in hooks {
            hook()
        }
    }
}

shape Named {
    Name string = default
}

shape StringConvertible {
    abstract ToString() -> string
}

shape Identified {
    Id uint64 = default
}

shape Versioned {
    Version uint64 = default
    
    IsNewerThan(other Versioned) -> bool
        return self.Version > other.Version
}

shape Parenting<T : Parenting<T> > {
    Parent T?
    Children {T} = {}

    SetParent(parent T) {
        self.Parent?.Children.Remove(self)
        parent.Children.Add(self)
        self.Parent = parent
    }

    RemoveParent() {
        self.Parent?.Children.Remove(self)
        self.Parent = null
    }

    IsChildOf(other T) -> bool
        return (self.Parent == other) || (self.Parent?.IsChildOf(other) ?? false)

    Root() -> T 
        return self.Parent?.Root() ?? self
}

shape Linked<T> {
    Next Linked<T>?

    HasNext() -> bool 
        return self.Next != null
}

#Lang("Array")
shape Array<T> {
    Len() -> uint64 return len self
    ToArray() -> [T] return self

    intrinsic Append(item T) -> bool
    intrinsic Add(item T, index uint64) -> bool
    intrinsic Remove(index uint64) -> bool

    Contains(item T) -> bool {
        for i in self
            if i == item return true
        return false
    }
    
    RemoveValue(item T) -> bool {
        for i in 0 ..< self.Len() {
            if self[i] == item 
                return self.Remove(i)
        }
        return false
    }
}

#Lang("Range")
shape Range {
    intrinsic ToArray() -> [int]

    intrinsic Create(start int, end int, by int) -> range
    intrinsic CreateExclusive(start int, end int, by int) -> range
}

#Lang("Set")
shape Set<T> {
    Len() -> uint64 return len self
    intrinsic ToArray() -> [T]
    
    intrinsic Add(item T) -> bool
    intrinsic Remove(item T) -> bool
    intrinsic Contains(item T) -> bool
}

#Lang("Dict")
shape Dict<K, V> {
    Len() -> uint64 return len self
    
    intrinsic Keys() -> {K}
    intrinsic Values() -> [V]
    
    intrinsic Set(key K, value V) -> bool
    intrinsic Remove(key K) -> bool

    intrinsic Get(key K) -> V?
    GetOr(key K, def K) -> V
        return self.Get(key) ?? def

    ContainsKey(key K) -> bool 
        return self.Get(key) != null
    ContainsValue(value V) -> bool 
        return self.Values().Contains(value)
}

shape Pair<K, V> {
    First K
    Second V

    Key() -> K return self.First
    Value() -> V return self.Second
}

shape Collection<T> {
    abstract Len() -> uint64
    abstract Contains(item T) -> bool
    abstract ToArray() -> [T]
}

shape Comparable<T> {
    abstract Compare(other T) -> int32
}

shape Equatable<T> {
    abstract Equals(other T) -> bool
}

shape Hashable {
    abstract Hash() -> uint64
}

shape Serializable {
    abstract Serialize() -> string
}

shape Cloneable<T> {
    abstract Clone() -> T
}

shape Benchmarking {
    static intrinsic GetTime() -> uint64

    StartTime uint64 = 0

    Start() {
        self.StartTime = GetTime()
    }

    Stop() {
        let difference = GetTime() - self.StartTime
        print "Time in millis: \{difference}"
    }
}

#Lang("Int32")
shape Int32 {
    static const MAX int32 = 2147483647
    //static const MIN int32 = -2147483648

    Negate() -> int32 return -self
}

#Lang("Bool")
shape Bool {
    static Eq(x bool, y bool) -> bool
        return x == y
    static NEq(x bool, y bool) -> bool
        return x != y
    static And(x bool, y bool) -> bool
        return x && y
    static Or(x bool, y bool) -> bool
        return x || y
    static Not(x bool) -> bool
        return !x

    static Parse(input string) -> bool?
        switch input.Lower().Trim() {
            "true" -> return true
            "false" -> return false
            else -> return null
        }

    static FromBinary(input number) -> bool?
        switch input {
            1 -> return true
            0 -> return false
            else -> return null
        }
}

#Lang("String")
shape String {
    Len() -> uint64 return len self

    StartsWith(substring string) -> bool {
        if self.Len() < substring.Len() return false

        for i in 0 ..< substring.Len() 
            if self[i] != substring[i] return false

        return true
    }
    EndsWith(substring string) -> bool {
        if self.Len() < substring.Len() return false

        for i in 0 ..< substring.Len() {
            let index = self.Len() - i - 1
            if self[index] != substring[index] return false
        }
            
        return true
    }

    intrinsic Upper() -> string
    intrinsic Lower() -> string
    intrinsic Trim() -> string
}

shape Point {
    X int = 0
    Y int = 0
}

shape Vec2 {
    X int = 0
    Y int = 0
}

shape IdDict : MapDict<uint64, Identified> (GetKey -> GetKey){
    GetKey(val Identified) -> uint64 
        return val.Id
}

shape NameDict : MapDict<string, Named> (GetKey -> GetKey){
    GetKey(val Named) -> string 
        return val.Name
}

shape MapDict<K, V> : DictWrapper<K,V> (
    ContainsValue -> ContainsValue
) {
    abstract GetKey(val V) -> K
    
    Set(value V) -> bool 
        return self::DictWrapper.Set(self.GetKey(value), value)
    Remove(value V) -> bool 
        return self::DictWrapper.Remove(self.GetKey(value))

    ContainsValue(value V) -> bool 
        return self.Get(self.GetKey(value)) != null
}

shape DictWrapper<K,V> {
    Dict {K:V} = {:}

    Len() -> uint64 return self.Dict.Len()
    
    Keys() -> {K} 
        return self.Dict.Keys()
    Values() -> [V] 
        return self.Dict.Values()
        
    Set(key K, value V) -> bool 
        return self.Dict.Set(key, value)
    Remove(key K) -> bool 
        return self.Dict.Remove(key)

    Get(key K) -> V? 
        return self.Dict.Get(key)
    GetOr(key K, def K) -> V 
        return self.Dict.GetOr(key, def)
        
    ContainsKey(key K) -> bool 
        return self.Dict.ContainsKey(key)
    ContainsValue(value V) -> bool 
        return self.Dict.ContainsValue(value)
}

shape Observable<T> {
    Listeners {|T|} = {}
    
    Notify(value T) {
        for listener in self.Listeners
            listener(value)
    }
    
    Subscribe(listener |T|)
        self.Listeners.Add(listener)
    
    Unsubscribe(listener |T|)
        self.Listeners.Remove(listener)
}

namespace Runtime {
    static intrinsic PrintObjects()
    static intrinsic PrintStack()
    static intrinsic PrintLocals()
}

print "standard library loaded"