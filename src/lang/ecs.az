using std

static Entities {ulong:Entity} = {:}

static IdCounter int = 0
static NextId() -> int {
    IdCounter += 1
    return IdCounter - 1
}

shape Entity : Named, Identified, Parenting<Entity> {
    static Create() -> Entity {
        return new Entity(
            Id = NextId()
        )
    }

    Tick() {}
    Load() {}
    Setup() {}
}

shape Vec3 : Cloneable<Vec3>(Clone -> Clone) {
    X double = 0
    Y double = 0
    Z double = 0

    Clone() -> Vec3 {
        return new Vec3(X=self.X, Y=self.Y, Z=self.Z)
    }
}
shape Scale {
    Scale Vec3 := Vec3(X=1,Y=1,Z=1)
}
shape Position {
    Position Vec3 := Vec3(X=1,Y=1,Z=1)
}
shape Rotation {
    Rotation Vec3 := Vec3(X=1,Y=1,Z=1)
}

shape Transform : Scale, Position, Rotation {}

shape MeshPoint : Position {
    U double = 0
    V double = 0
}

shape Mesh {
    Points {MeshPoint} = {}
}

let obj := Transform
print obj
print obj.Scale

let obj2 := Transform
print obj2
obj.Scale.X = 5
obj2.Scale.X = 6

print obj.Scale
print obj2.Scale

obj := Entity
print obj

let binkus = obj.Position.Clone()
obj.Position.X = 100

print obj.Position
print binkus

static Thing |(int, int) -> int| = |(x, y) -> int { return x + y }|
print Thing(4, 3)

let newEntity = Entity.Create()
print newEntity