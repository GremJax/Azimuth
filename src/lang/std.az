        for i in 0 ... substring.Len() {
            let index = self.Len() - i - 1
            if self[index] != substring[index] return false
        }
            
        return true
    }
*/

    intrinsic Upper() -> string
    intrinsic Lower() -> string
    intrinsic Trim() -> string
}

shape Point {
    X int
    Y int
}

shape Vector {
    X int
    Y int
}

shape Observable<T> {
    Listeners {|T|}  = {}
    
    Notify(T value) {
        for listener in self.Listeners
            listener(value)
    }
    
    Subscribe(|T| listener)
        self.Listeners.Add(listener)
    
    Unsubscribe(|T| listener)
        self.Listeners.Remove(listener)
}

print "standard library loaded"