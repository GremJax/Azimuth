using std

alias EntityId -> ulong

static Entities {EntityId : Entity} = {:}
static TickOrder [EntityId] = []

static Tick() {
    for entityId in TickOrder {
        Entities[entityId].Tick()
    }
}

static IdCounter EntityId = 0
static NextId() -> EntityId {
    IdCounter += 1
    return IdCounter - 1
}

shape Entity : Named, Identified, Parenting<Entity> {
    static Create() -> Entity {
        let entity = new Entity(
            Id = NextId()
        )
        Entities[entity.Id] = entity
        TickOrder.Append(entity.Id)
        return entity
    }

    Delete() {
        //Entities.Remove(self.Id)
        //TickOrder.RemoveValue(self.Id)
    }

    Tick() {}
    Load() {}
    Setup() {}
}

shape Vec3 : Cloneable<Vec3>(Clone -> Clone) {
    X double = 0
    Y double = 0
    Z double = 0

    Clone() -> Vec3 {
        return new Vec3(X=self.X, Y=self.Y, Z=self.Z)
    }
}
shape Scale {
    Scale Vec3 := Vec3(X=1,Y=1,Z=1)
}
shape Position {
    Position Vec3 = default
}
shape Rotation {
    Rotation Vec3 = default
}

shape Transform : Scale, Position, Rotation {}

shape MeshPoint : Position, Identified {
    U double = 0
    V double = 0
}

shape MeshEdge {
    First uint64
    Second uint64
}

shape Mesh {
    Points {MeshPoint} = {}
    Edges {MeshEdge} = {}
}
