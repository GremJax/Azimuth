print "loading standard library..."

shape Object {} 

namespace Math {

    static Neg(number x) -> number 
        return -x
    static BWNot(number x) -> number 
        return ~x

    static Succ(number x) -> number 
        return x + 1

    static Add(number a, number b) -> number 
        return a + b
    static Sub(number a, number b) -> number 
        return a - b
    static Mul(number a, number b) -> number 
        return a * b
    static Div(number a, number b) -> number 
        return a / b
    static Mod(number a, number b) -> number 
        return a % b

    static BWAnd(number a, number b) -> number 
        return a & b
    static BWOr(number a, number b) -> number 
        return a | b
    static BWXor(number a, number b) -> number 
        return a ^ b
    static BWLShift(number a, number b) -> number 
        return a << b
    static BWRShift(number a, number b) -> number 
        return a >> b

    static Abs(number x) -> number 
        return (x >= 0) ? x : -x
    static Max(number a, number b) -> number 
        return (a >= b) ? a : b
    static Min(number a, number b) -> number 
        return (a <= b) ? a : b
    static Clamp(number x, number min, number max) -> number 
        return Max(min, Min(max, x))
    static Sgn(number x) -> number 
        return (x > 0) ? 1 : (x < 0) ? -1 : 0

    static IsEven(number x) -> bool
        return (x % 2) == 0
    static IsOdd(number x) -> bool
        return (x % 2) != 0
    static LT(number a, number b) -> bool
        return a < b
    static LTE(number a, number b) -> bool
        return a <= b
    static GT(number a, number b) -> bool
        return a > b
    static GTE(number a, number b) -> bool
        return a >= b
    static Eq(number a, number b) -> bool
        return a == b
    static NEq(number a, number b) -> bool
        return a != b

    static GCD(number a, number b) -> number {
        while b != 0 {
            let temp = b
            b = a % b
            a = temp
        }
        return a
    }
    static LCM(number a, number b) -> number {
        if a == 0 || b == 0 return 0
        return (a / GCD(a, b)) * b
    }
    static Mid(number a, number b) -> number {
        let max = Max(a,b)
        let min = Min(a,b)
        return min + ((max - min) / 2)
    }

    static Reflect(number x, number mid) -> number 
        return (2 * mid) - x

    static Pow(number x, number exp) -> number {
        let res = 1
        for i in 1 ... exp {
            res *= x
        }
        return res
    }

    static intrinsic Sqrt(number x) -> number

    static Floor(double x) -> double
        return x - x%1 + 1
    static Ceil(double x) -> double
        return x - x%1
}

namespace IO {
    static Print(string x) print x

    static intrinsic ReadLine() -> string?
    static intrinsic Args() -> [string]
}

namespace Random {
    static intrinsic Int() -> int32
    static intrinsic Range(int from, int to) -> int32

    static Chance(int chance) -> bool 
        return Random.Range(1, chance) == 1

    static Bool() -> bool 
        return Random.Chance(2)
}

shape Error {
    Message string
    Throw() throw self.Message

    static Try(|() -> Object| func) -> bool
        return func() !~ Error
}

shape Executor {
    Run([|() -> void|] hooks) {
        for hook in hooks {
            hook()
        }
    }
}

shape Named {
    Name string
}

shape StringConvertible {
    abstract ToString() -> string
}

shape Identified {
    Id uint64
}

shape Versioned {
    Version uint64
    
    IsNewerThan(Versioned other) -> bool
        return self.Version > other.Version
}

shape Parenting<T : Parenting<T> > {
    Parent T?
    Children {T} = {}

    SetParent(T parent) {
        self.Parent?.Children.Remove(self)
        parent.Children.Add(self)
        self.Parent = parent
    }

    RemoveParent() {
        self.Parent?.Children.Remove(self)
        //self.Parent = null
    }

    IsChildOf(T other) -> bool
        return (self.Parent == other) || (self.Parent?.IsChildOf(other) ?? false)

    Root() -> T 
        return self.Parent?.Root() ?? self
}

shape Linked<T> {
    Next Linked<T>?
}

shape Array<T> {
    Len() -> uint64 return len self
    //ToArray() -> [T] return self

    intrinsic Append(T item) -> bool
    intrinsic Add(T item, uint64 index) -> bool
    intrinsic Remove(T item, uint64 index) -> bool

    Contains(T item) -> bool {
        //for i in self
        //    if i == item return true
        return false
    }
}

shape Range {
    intrinsic ToArray() -> [int]

    intrinsic Create(int start, int end, int by) -> range
    intrinsic CreateExclusive(int start, int end, int by) -> range
}

shape Set<T> {
    Len() -> uint64 return len self
    intrinsic ToArray() -> [T]
    
    intrinsic Add(T item) -> bool
    intrinsic Remove(T item) -> bool
    intrinsic Contains(T item) -> bool
}

shape Dict<K, V> {
    Len() -> uint64 return len self
    
    intrinsic Keys() -> {K}
    intrinsic Values() -> [V]
    
    intrinsic Set(K key, V value) -> bool
    intrinsic Remove(K key) -> bool

    intrinsic Get(K key) -> V?
    GetOr(K key, K default) -> V
        return self.Get(key) ?? default

    ContainsKey(K key) -> bool 
        return self.Get(key) != null
    ContainsValue(V value) -> bool 
        return self.Values().Contains(value)
}

shape Pair<K, V> {
    First K
    Second V

    Key() -> K return self.First
    Value() -> V return self.Second
}

shape Collection<T> {
    abstract Len() -> uint64
    abstract Contains(T item) -> bool
    abstract ToArray() -> [T]
}

shape Comparable<T> {
    abstract Compare(T other) -> int32
}

shape Equatable<T> {
    abstract Equals(T other) -> bool
}

shape Hashable {
    abstract Hash() -> uint64
}

shape Serializable {
    abstract Serialize() -> string
}

shape Cloneable<T> {
    abstract Clone() -> T
}

shape Benchmarking {
    static intrinsic GetTime() -> uint64

    StartTime uint64 = 0

    Start() {
        self.StartTime = GetTime()
    }

    Stop() {
        let difference = GetTime() - self.StartTime
        print "Time in millis: \{difference}"
    }
}

shape Int32 {
    static const MAX int32 = 2147483647
    static const MIN int32 = -2147483648

    Negate() -> int32 return -self
}

shape Bool {
    static Eq(bool x, bool y) -> bool
        return x == y
    static NEq(bool x, bool y) -> bool
        return x != y
    static And(bool x, bool y) -> bool
        return x && y
    static Or(bool x, bool y) -> bool
        return x || y
    static Not(bool x) -> bool
        return !x

    static Parse(string input) -> bool?
        switch input.Lower().Trim() {
            "true" -> return true
            "false" -> return false
            else -> return null
        }

    static FromBinary(number input) -> bool?
        switch input {
            1 -> return true
            0 -> return false
            else -> return null
        }
}

shape String {
    Len() -> uint64 return len self

/*
    StartsWith(string substring) -> bool {
        if self.Len() < substring.Len() return false

        for i in 0 ... substring.Len() 
            if self[i] != substring[i] return false

        return true
